OUTPUT_DIR=output
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
MAX_STORY_AGE_HOURS=72
TTS_VOICE=en-IN-PrabhatNeural
TTS_RATE=+12%
TTS_PITCH=+0Hz
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
RSS_FEEDS=https://www.technologyreview.com/feed/,https://techcrunch.com/category/artificial-intelligence/feed/,https://hnrss.org/frontpage
TOPIC_KEYWORDS=AI,artificial intelligence,machine learning,LLM,robotics,OpenAI,Google Gemini,Claude,agent,technology,GPU

# Optional publishing configuration (add real credentials as GitHub Actions secrets, never commit them)
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=28
META_GRAPH_API_VERSION=vXX.X
INSTAGRAM_USER_ID=
# Use GitHub Secrets for INSTAGRAM_ACCESS_TOKEN, YOUTUBE_CLIENT_ID,
# YOUTUBE_CLIENT_SECRET, and YOUTUBE_REFRESH_TOKEN.
